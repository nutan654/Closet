# Server
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
SHUTDOWN_TIMEOUT=10s

# Database
DATABASE_URL=postgres://closet:closet@localhost:5432/closet?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_QUERY_TIMEOUT=5s

# Auth — generate a real secret with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-before-deploying
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12
AUTH_RATE_LIMIT_PER_MIN=10

# Logging
LOG_LEVEL=debug

# Storage (Phase 3) — "local" writes to disk under STORAGE_LOCAL_DIR and
# serves files back at STORAGE_BASE_URL; "gcs" writes to a real Google
# Cloud Storage bucket; "s3" writes to any S3-compatible bucket
# (Cloudflare R2, Backblaze B2, real AWS S3) — see internal/storage/.
STORAGE_PROVIDER=local
STORAGE_BUCKET=uploads
STORAGE_BASE_URL=http://localhost:8080/uploads
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_MAX_FILE_SIZE_MB=10
STORAGE_UPLOAD_TIMEOUT=30s

# Only read when STORAGE_PROVIDER=gcs. Leave blank to use Application
# Default Credentials (the right choice on Cloud Run/GKE, or locally via
# `gcloud auth application-default login`) — a real deployment normally
# doesn't set this at all.
GCS_CREDENTIALS_FILE=

# Only read when STORAGE_PROVIDER=s3. STORAGE_S3_ENDPOINT is the
# S3-compatible API endpoint (e.g. https://<account_id>.r2.cloudflarestorage.com
# for Cloudflare R2, or https://s3.<region>.backblazeb2.com for B2); leave
# blank only if you're pointing this at real AWS S3. STORAGE_BASE_URL must
# be the bucket's *public* URL (a custom domain or public-bucket URL) —
# it's a different thing from STORAGE_S3_ENDPOINT, which isn't browsable.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# Image processing (Phase 3)
MAX_IMAGE_WIDTH=2000
MAX_IMAGE_HEIGHT=2000
THUMBNAIL_WIDTH=400
THUMBNAIL_HEIGHT=400
IMAGE_JPEG_QUALITY=85

# Pattern service (Phase 5) — the Python microservice under pattern-service/
PATTERN_SERVICE_URL=http://localhost:8000
PATTERN_SERVICE_TIMEOUT=15s

# Set to true only if the pattern service is deployed somewhere that
# issues Google ID tokens (e.g. Cloud Run with
# --no-allow-unauthenticated). When true, every request to
# PATTERN_SERVICE_URL is signed with a Google ID token via Application
# Default Credentials. Leave false for local dev and for the free Render
# deployment (see DEPLOYMENT_RENDER.md) — neither has a GCP identity to
# sign with.
PATTERN_SERVICE_USE_ID_TOKEN=false

# Optional shared secret sent as X-API-Key to the pattern service. Not
# needed for local dev (docker-compose's pattern-service isn't
# internet-reachable). Set this when the pattern service is deployed as a
# *public* URL (e.g. Render's free tier, which has no private-service
# option) — must match PATTERN_SERVICE_API_KEY set on the pattern
# service itself. Leave blank to disable the check entirely.
PATTERN_SERVICE_API_KEY=

# Bear (Companion chat) — internal/companion + CompanionHandler. Optional:
# leaving this blank does NOT stop the server from starting, it just
# disables the /companion/chat endpoint (returns a friendly 503 instead
# of a raw upstream error). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
COMPANION_MODEL=gemini-2.5-flash
COMPANION_TIMEOUT=20s
